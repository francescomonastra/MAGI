{"nodes": [{"id": "docs_magi_state_reference_magi", "label": "MAGI (Conditional VAE surrogate)", "file_type": "concept", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.1 \u00a71 Scope", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_cryosphere", "label": "CryoSphere", "file_type": "concept", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.1 \u00a71 Scope", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_v0_8_2", "label": "MAGI v0.8.2 (validated model version)", "file_type": "concept", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.1 \u00a71.1 Model version under validation", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_v0_8_3", "label": "MAGI v0.8.3 (energy_condition_geometry=True, latent_dim=12)", "file_type": "concept", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.1 \u00a71.1 Model version under validation", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_cvae_mixenergy_contphi_taskadaptive", "label": "CVAE_MixEnergy_ContPhi_TaskAdaptive", "file_type": "code", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.1 \u00a71.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_normalization_free_comparison_r", "label": "Normalization-free comparison (R metric)", "file_type": "rationale", "rationale": "R = (N_events/N_crossings)^MAGI / (N_events/N_crossings)^real is used for every headline number because it requires no exposure, detector area, flux normalization, or crossing efficiency chi, making it insensitive to every quantity that has historically caused discordance between MAGI-side and Geant4-side bookkeeping.", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.1-2 \u00a72 eq.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_efficiency_factor_epsilon", "label": "Efficiency factor (epsilon)", "file_type": "rationale", "rationale": "epsilon = (N_counts/N_shot)^MAGI / (N_counts/N_shot)^ref, R = epsilon x chi; retained only for continuity with earlier analysis. A perfect surrogate returns epsilon = 1/chi, not 1.", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.2 \u00a72 eq.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_result_1_dm1_2_cosmic_rays", "label": "Result 1 \u2014 Cosmic rays, DM1.2 laboratory cryostat", "file_type": "concept", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.2-3 \u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_dm1_2_laboratory_cryostat", "label": "DM1.2 laboratory cryostat model", "file_type": "concept", "rationale": "Chosen for the paper figures over Torio and Radio because their v0.8.2 checkpoints on this machine are incomplete (weights still on Drive); the choice is not the one the mean-|delta rho| summary statistic alone would make.", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.2 \u00a73 / p.6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_result_2_sron_xifu_cosmic_rays", "label": "Result 2 \u2014 Cosmic rays, SRON X-IFU model", "file_type": "concept", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.3-4 \u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_sron_x_ifu_model", "label": "SRON X-IFU model", "file_type": "concept", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.3 \u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_result_3_40k_sron_buildingmodel", "label": "Result 3 \u2014 40K, SRON BuildingModel", "file_type": "concept", "rationale": "The R=1.118\u00b10.373 closure number is unchanged and remains valid as a closure result (MAGI reproduces the distribution it was trained on and survives transport to detector level), but it is NOT evidence about real 40K background physics, because both comparison arms draw on the same albedo-biased training population.", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.5 \u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_dm127_acdsd", "label": "DM127 (anti-coincidence detector, ACDSD)", "file_type": "concept", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.2 \u00a73 \u201cWhat can and cannot be claimed\u201d", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_gdmldetectorconstruction_cc", "label": "GDMLDetectorConstruction.cc", "file_type": "code", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.2 \u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_platecu1", "label": "PlateCu1 (copper disc geometry volume)", "file_type": "code", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.3 \u00a73 \u201cPrerequisite finding\u201d", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_geometry_overlap_bug_39pct", "label": "CryoSphere/PlateCu1 overlap bug (39% crossing loss)", "file_type": "rationale", "rationale": "At R=105mm the CryoSphere intersected PlateCu1 (a 150mm-radius, 5mm-thick copper disc) by at least 1.29mm with overlap checking disabled; Geant4 navigation inside an overlap is undefined and 39.4% of detector events had no recorded crossing, uniform 58-63% across five runs, 93.5% of them primary-muon deposits. Moving the sphere to R=95mm restores 100.0% coverage; the SRON sphere was checked and is clean.", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.3 \u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_eventaction_cc", "label": "EventAction.cc", "file_type": "code", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.4 \u00a74 / p.5 \u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_ingoing_particle_cut_inconsistency", "label": "Inconsistent ingoing-particle cut", "file_type": "rationale", "rationale": "EventAction.cc skips outgoing crossings at registration, but the SRON training sets predate that code (CR set contains 10.37% outgoing crossings, 40K set 22.53%, DM1.2 set 0.00%). MAGI applies no ingoing/outgoing selection and generates 13.59% outgoing against the CR training set's 10.37%, accounting for 3.6% of the SRON rate deficit. This also means the SRON and DM1.2 models are on different conventions.", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.4 \u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_sron_deficit_24pct", "label": "SRON CR ~24% rate deficit", "file_type": "concept", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.4 \u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_s1gdmlsron_cryosphereemission", "label": "Old-Simulations/Sim/S1GDMLSRON_CryoSphereEmission", "file_type": "document", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.5 \u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_sphere_center_bug_2500mm", "label": "SphereCenter 2500mm error (EventAction.cc:237)", "file_type": "rationale", "rationale": "EventAction.cc:237 carries SphereCenter(0.,0.,-3007.6*mm), a 2500mm error versus the true centre of -507.66mm. 100.00% of recorded crossings are ingoing w.r.t. the wrong centre (97.28% moving downward) versus 77.45% ingoing w.r.t. the true centre \u2014 40K gammas travelling up from the floor were being selected as if a cut toward a centre 2500mm below kept only photons that scattered off the structure above and came back.", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.5 \u00a75, Correction box 17/08/2026", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_training_population_is_albedo", "label": "40K training population is albedo, not the crossing population", "file_type": "rationale", "rationale": "The spectrum confirms the SphereCenter bug independently: median deposited energy is 211.2 keV against the Compton 180\u00b0 backscatter energy of the 1460.8 keV line (217.5 keV); 30.4% of crossings lie within \u00b115% of it; the 1461 keV line appears only once in 1.87M events (an unscattered line photon cannot be moving downward at the sphere). Ra-226 and Th-232 are affected identically. The detector-level closure numbers survive unchanged as a self-consistency check but must NOT be restated as a physics claim about real 40K background.", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.5 \u00a75, Correction box 17/08/2026", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_gap_22x_superseded_explanation", "label": "The 22x gap \u2014 superseded explanation", "file_type": "rationale", "rationale": "Previously attributed to the CR/40K runs not sharing a 40K source volume (a 57x ratio between a 2000x2000x400mm box and a 750x750x50mm box). That attribution is now known to be incomplete and its direction was wrong: the user confirmed the slab was the reduced one and the model unshielded, so both runs sample the same physical volume and the 57x factor never applied as stated. The dominant, corrected cause is the albedo-selection bug instead; the conclusion (MAGI sits with the population it was trained on) still stands, but for a different and larger reason.", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.5 \u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_reference_44_days", "label": "44-days reference (40K)", "file_type": "document", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.5 \u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_ngenpotassiumformagi_v082", "label": "NgenPotassiumForMAGI_v082 bookkeeping correction", "file_type": "rationale", "rationale": "Declared as 580,000,000 but measured from the run's own output as 538,205,667 (7.8% high, outside the 95% region of both jobs' order statistics), caused by the output file concatenating two jobs with exactly one backward EventId jump at row 398,400. Every v0.8.2 40K flux and efficiency number rises by a correction factor of 1.0777 (e.g. Detector-1 efficiency 3472\u21923741); the detector-level closure result above is unaffected because it never uses this constant.", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.6 \u201cBookkeeping correction\u201d", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_make_fig1_py", "label": "paper_figures/make_fig1.py", "file_type": "code", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.6 \u00a76 Figures for the proceeding", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_make_fig2_py", "label": "paper_figures/make_fig2.py", "file_type": "code", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.6 \u00a76 Figures for the proceeding", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_figure_1_spectral_comparison", "label": "Figure 1 \u2014 spectral comparison", "file_type": "image", "rationale": "Caption must state that the two panels sit on different flux references \u2014 panel (a) uses Sim/OmniFluxes.tsv with R_gen=118cm, panel (b) uses Sim/S1GDMLSRON/OmniFluxes_Run1.tsv with the Building radius and its scale factors \u2014 the y-axes are not comparable between panels.", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.6 \u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_run_cryoac_reference", "label": "RUN CRYOAC reference", "file_type": "document", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.3 \u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_torio_radio_checkpoints", "label": "Torio and Radio (alternative datasets, incomplete checkpoints)", "file_type": "concept", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.6 \u201cWhy DM1.2 and not the others\u201d", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_dm1_2_iso_rerun", "label": "DM1.2 iso rerun (vs. focused macro)", "file_type": "rationale", "rationale": "The DM1.2 muon macro had previously used /gps/ang/type focused ten times, aiming every muon at the origin (median cos 0.994 to the origin, 56.8% inside cos>0.99); absolute rates from that configuration were never physical. All DM1.2 results in this document are from the iso (isotropic) rerun instead.", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.3 \u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_sron_buildingmodel", "label": "SRON BuildingModel (CCNCoolerwithXFDM_noShields_BuildingModel.gdml)", "file_type": "concept", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.5 \u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_sim_omnifluxes_tsv", "label": "Sim/OmniFluxes.tsv", "file_type": "document", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.6 Figure 1 caption", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_sim_s1gdmlsron_omnifluxes_run1_tsv", "label": "Sim/S1GDMLSRON/OmniFluxes_Run1.tsv", "file_type": "document", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.6 Figure 1 caption", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_magi_state_reference_provenance_tag_table_4", "label": "Provenance tag system (Table 4)", "file_type": "rationale", "rationale": "Every numeric claim in the document carries a provenance tag [Ex] resolving to Table 4; tags point at files and runs on the local machine, not literature citations \u2014 this exists so numbers entering the proceeding and flash talk can be traced to the run that produced them. Superseded and withdrawn results are retained and marked, not deleted.", "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.1 Status of this document", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_magi_state_reference_magi", "target": "docs_magi_state_reference_cryosphere", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/MAGI_state_reference.pdf", "source_location": "p.1 \u00a71", "weight": 1.0}, {"source": "docs_magi_state_reference_v0_8_2", "target": "